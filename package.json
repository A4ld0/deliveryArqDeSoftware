{
  "name": "delivery-equipo4",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "build:api": "npm run build --workspace apps/api",
    "test:api": "npm run test --workspace apps/api",
    "test:web": "npm run test --workspace apps/web -- --watch=false --browsers=ChromeHeadless",
    "test:all": "npm run test:api && npm run test:web",
    "lint:api": "npm run lint --workspace apps/api",
    "dev:web": "npm run start --workspace apps/web",
    "build:web": "npm run build --workspace apps/web"
  },
  "engines": {
    "node": ">=20"
  }
}
